# ---------------------------------------------------------------------------
# LexGuard 配置模板。复制为 .env 后按需填写。
# 不填任何内容也能完整运行：默认使用内置 Mock LLM + 本地演示语料。
# ---------------------------------------------------------------------------

# LLM：任意 OpenAI 兼容的 /chat/completions 接口
# 例：DeepSeek https://api.deepseek.com/v1 | 通义 https://dashscope.aliyuncs.com/compatible-mode/v1
#     OpenAI https://api.openai.com/v1 | 本地 Ollama http://localhost:11434/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# LLM_API_KEY 为空 => 自动切换内置 Mock LLM（无需网络、无需密钥）
# 也可显式强制：LLM_PROVIDER=mock | openai
LLM_PROVIDER=

# 法律数据源：local（内置演示语料）| http（自建检索服务）
LAW_DATASOURCE=local
LAW_DATASOURCE_URL=
LAW_DATASOURCE_TOKEN=

# 后端端口
PORT=3001
